<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Înregistrare — Aventura Travel</title>
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/resurse/css/app-features.css">
</head>
<body>
<%- include('../fragmente/header.ejs') %>
<main class="app-page">
    <section class="auth-card">
        <h1>Creează cont</h1>
        <form id="form-register" class="app-form">
            <label>Nume <input type="text" name="nume" required></label>
            <label>Email <input type="email" name="email" required></label>
            <label>Telefon <input type="tel" name="telefon"></label>
            <label>Parolă <input type="password" name="parola" minlength="6" required></label>
            <p id="reg-eroare" class="form-error" hidden></p>
            <button type="submit" class="btn btn-primary">Înregistrează-te</button>
        </form>
        <p>Ai deja cont? <a href="/login">Autentifică-te</a></p>
    </section>
</main>
<%- include('../fragmente/footer.ejs') %>
<script>
document.getElementById('form-register').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const err = document.getElementById('reg-eroare');
    err.hidden = true;
    const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(fd))
    });
    const data = await res.json();
    if (!res.ok) { err.textContent = data.error || 'Eroare'; err.hidden = false; return; }
    location.href = '/';
});
</script>
</body>
</html>
