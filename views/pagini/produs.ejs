<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="Descoperă lumea cu Aventura travel, partenerul tău de încredere în aventuri inedite și experiențe de neuitat! Cu o pasiune nesfârșită pentru călătorii și o dedicare profundă pentru explorarea frumuseților ascunse ale lumii, agenția noastră de turism este aici pentru a transforma visul tău de a călători într-o realitate plină de amintiri prețioase.">
        <meta name="keywords" content="agentie de turism,Aventura travel,vacanta,Pachete turistice,Atracții turistice,City break-uri,Europa, Elvetia,Viena">
        
        <title>Aventura travel - home</title>
        <%- include("../fragmente/head") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    </head>
    <body>
    <%- include("../fragmente/header") %>

    <main>
        <section>
            <h2>Pagină produs</h2>
                <article id="art-produs">
                    <h3><span class="nume"><%- locals.prod.destinatie %></span></h3>
                    <p>Pret: <span class="pret"><%- locals.prod.pret %> </span></p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.descriere %> </span></p>
                    <p>Destinatie: <span class="destinatie"><%- locals.prod.destinatie %> </span></p>
                    <p>Obiective turistice: <span class="obiective_turistice"><%- locals.prod.obiective_turistice %> </span></p>
                    <p>Persoane: <span class="persoane"><%- locals.prod.persoane %> </span></p>
                    <p>Categorie: <span class="categorie"><%- locals.prod.categorie %> </span></p>
                    <p>Pentru studenti: <span class="pt_studenti"><%- locals.prod.pt_studenti %> </span></p>
                    <p>Data adăugare: <span class="data_adaugare"><%- locals.prod.data_adaugare %> </span></p>
                    <figure class="imag-produs">
                        <img  src="/resurse/imagini/produse/<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.destinatie %>]" />
                    </figure>    
                </article>
            
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>