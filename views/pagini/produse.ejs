<!DOCTYPE html>
<html lang="ro">
<head>
    <meta name="description" content="Pachete turistice Aventura Travel — destinații, city break-uri și vacanțe.">
    <meta name="keywords" content="agentie de turism,Aventura travel,vacanta,Pachete turistice">
    <title>Pachete turistice — Aventura Travel</title>
    <%- include("../fragmente/head") %>
    <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
    <link rel="stylesheet" href="/resurse/css/app-features.css">
    <script type="text/javascript" src="/resurse/js/produse.js"></script>
</head>
<body>
<%- include("../fragmente/header") %>
<main class="app-page">
    <h1>Pachete turistice</h1>
    <p><a class="btn btn-primary" href="/cautare">Căutare avansată</a>
       <a class="btn btn-outline" href="/recomandari">Recomandări</a></p>

    <div class="filtre-rapide" style="margin:1rem 0;display:flex;flex-wrap:wrap;gap:0.5rem;">
        <a class="btn btn-outline" href="/produse">Toate</a>
        <a class="btn btn-outline" href="/produse?tip=cultural">Cultural</a>
        <a class="btn btn-outline" href="/produse?tip=aventura">Aventură</a>
        <a class="btn btn-outline" href="/produse?tip=relaxare">Relaxare</a>
        <a class="btn btn-outline" href="/produse?tip=urban">Urban</a>
    </div>

    <label> Nume: <input type="text" id="inp-nume"></label>
    <label> Pret minim: <input type="range" id="inp-pret" value="0" min="0" max="5000"> <span id="infoRange">(0)</span></label>
    <label>Select categorie:
        <select id="inp-categorie">
            <option id="sel-toate" selected value="toate">toate</option>
            <% for (let opt of locals.optiuni) { %>
                <option value="<%- opt.unnest %>"><%- opt.unnest %></option>
            <% } %>
        </select>
    </label>
    <p>
        <button id="filtrare">Filtreaza</button>
        <button id="resetare">Reseteaza</button>
        <button id="sortCrescNume">Sorteaza crescator</button>
        <button id="sortDescrescNume">Sorteaza descrescator</button>
    </p>
    <p id="p-suma">Apăsați Alt+"c" pentru suma preturilor produselor afișate.</p>

    <section id="produse">
        <h2>Destinații<% if (filtruTip) { %> — <%= filtruTip %><% } %></h2>
        <div class="grid-produse grid-pachete">
            <% for (let prod of locals.produse) { %>
            <article class="produs card-pachet"
                data-pret="<%= prod.pret_final %>"
                data-categorie="<%= prod.categorie %>"
                data-nume="<%= prod.destinatie %>">
                <h3 class="nume">
                    <a href="/produs/<%= prod.id %>">
                        <span class="val-nume"><%= prod.destinatie %></span>
                    </a>
                </h3>
                <div class="info-prod">
                    <p class="pret">Preț:
                        <span class="val-pret"><%= prod.pret_final %></span> RON
                        <% if (prod.reducere_procent > 0) { %>
                        <span class="badge-reducere">−<%= prod.reducere_procent %>%</span>
                        <% } %>
                    </p>
                    <p>Tip: <%= prod.tip_turism %> · <%= prod.durata_zile %> zile</p>
                    <p class="persoane">Locuri: <span class="persoane"><%= prod.locuri_disponibile %></span></p>
                </div>
                <p class="categorie">Categorie: <span class="val-categorie"><%= prod.categorie %></span></p>
                <figure>
                    <a href="/produs/<%= prod.id %>">
                        <img src="/resurse/imagini/pachete/<%= prod.imagine || 'default.jpg' %>"
                             style="width:100%;height:auto;border-radius:6px;"
                             alt="<%= prod.destinatie %>"
                             onerror="this.src='/resurse/imagini/galerie/mare/1.jpg'">
                    </a>
                </figure>
                <p><a class="btn btn-primary" href="/produs/<%= prod.id %>">Detalii & rezervare</a></p>
            </article>
            <% } %>
        </div>
    </section>
</main>
<%- include("../fragmente/footer") %>
</body>
</html>
