<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="Descoperă lumea cu Aventura travel, partenerul tău de încredere în aventuri inedite și experiențe de neuitat! Cu o pasiune nesfârșită pentru călătorii și o dedicare profundă pentru explorarea frumuseților ascunse ale lumii, agenția noastră de turism este aici pentru a transforma visul tău de a călători într-o realitate plină de amintiri prețioase.">
        <meta name="keywords" content="agentie de turism,Aventura travel,vacanta,Pachete turistice,Atracții turistice,City break-uri,Europa, Elvetia,Viena">
        <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
        <title>Aventura travel - home</title>
        <%- include("../fragmente/head") %>     
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <script type="text/javascript" src=/resurse/js/produse-cos.js></script>
        <title>Produse</title>
    </head>
    <body>
    <%- include("../fragmente/header") %>

    <main>
        <label> Nume: <input type="text" id="inp-nume"></label>
        <div class="form-floating mb-3">
            <textarea class="form-control" id="floatingInput" placeholder="name@example.com"></textarea>
          
          </div>
          <div class="form-floating">
            <input type="password" class="form-control" id="floatingPassword" placeholder="Password">
            <label for="floatingPassword">Password</label>
          </div>
          <form action="/action_page.php">
            <p><label for="w3review">Review Aventura Travel:</label></p>
            <textarea id="w3review" name="w3review" rows="4" cols="50"></textarea>
            <br>
            <input type="submit" value="Submit">
          </form>
        <!--<label> Maxim persoane: <input type="number" id="inp-persoane" value="10000"></label>-->
        <div> Persoane:<!-- trebuie sa aiba acelasi name ca sa formeze un grup -->
            <p><label>Neocupat (persoane &lt; 0)
                <input id="i_rad1"  name="gr_rad" value="0" type="radio"/>
            </label></p>
            <p><label>Mediu (35 &le; persoane &lt; 60)
                <input id="i_rad2"  name="gr_rad" value="35:60" type="radio"/>
            </label>
            <p><label> Grad ridicat  de ocupare (70 &le; persoane)
                <input id="i_rad3" name="gr_rad" value="70:1000000000" type="radio"/>
            </label>
            <p><label>Toate
                <input id="i_rad4" checked name="gr_rad" value="toate" type="radio"/>
            </label>
        </div>


        <label> Pret minim: <input type="range" id="inp-pret" value="0" min="1500"  max="3500"> <span id="infoRange">(0)</span></label>
        <label>Select simplu:
            <select id="inp-categorie">
                <option id="sel-toate" selected value="toate">toate</option>
                <% for (let opt of locals.optiuni) { %>
                    <option value="<%- opt.unnest %>"><%- opt.unnest %> </option>
                <% } %>
            </select>
        </label>

        <p>
        <button id="filtrare">Filtreaza</button> 

        <button id="resetare">Reseteaza</button><br/>
        <button id="sortCrescNume">Sorteaza crescator dupa pret si nume</button>
        <button id="sortDescrescNume">Sorteaza descrescator dupa pret si nume</button>
        
        </p>
        
        <p id="p-suma">Apăsați Alt+"c" pentru suma preturilor produselor afișate. </p>
        <section id="produse">
            <h2>Produse</h2>
            <div class="grid-produse">
                <% for( let prod of locals.produse) { %>
                    <article class="produs" >
                        <h3 class="nume">Nume: <a href="/produs/<%-prod.id %>" ><span class="val-nume"><%- prod.destinatie%></span></a></h3>
                        <div class="info-prod">
                            <p class="pret">Pret: <span class="val-pret"><%- prod.pret%></span></p>
                            <p class="obiective_turistice">Obiective turistice: <span class="val-obiective_turistice"><%- prod.obiective_turistice%></span></p>
                            <p class="persoane">Persoane: <span class="persoane"><%- prod.persoane%></span></p>
                        </div>
                        <p class="categorie">Categorie:<span class="val-categorie"><%- prod.categorie%></span></p>
                        <figure>
                            <a href="/produs/<%-prod.id %>" ><img src="/resurse/imagini/produse/<%- prod.imagine%>" style="width:50%;height:auto;" alt="[imagine <%- prod.destinatie %>]" /></a>
                        </figure>
                        <label class="selecteaza-cos">
                            Selectează:<br/>
                            <input type="checkbox" class="select-cos" value="<%-prod.id %>" autocomplete="off">
                        </label>
                    </article>
                <% }%>
            </div>
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>