<script src="/resurse/js/tema.js"></script>
<% if (typeof user !== 'undefined' && user) { %>
<div class="user-bar">
  <span>Salut, <strong><%= user.nume %></strong> (<%= user.rol %>)</span>
  <a href="/rezervarile-mele">Rezervări</a>
  <a href="/wishlist">♥ Wishlist</a>
  <a href="/recomandari">Recomandări</a>
  <a href="/notificari" id="link-notif">Notificări</a>
  <% if (user.rol === 'administrator' || user.rol === 'angajat') { %>
  <a href="/admin">Admin</a>
  <% } %>
  <a href="/logout">Logout</a>
</div>
<% } else { %>
<div class="user-bar">
  <a href="/login">Login</a>
  <a href="/register">Register</a>
  <a href="/cautare">Căutare</a>
  <a href="/recomandari">Recomandări</a>
  <a href="/chat">Chatbot AI</a>
  <a href="/harta">Hartă</a>
</div>
<% } %>
<nav>
    <label id="hamburger" for="ch-menu">
        <div class="hamburger-icon" aria-label="Meniu" role="button">
            <span class="hamburger-bar bar-1"></span>
            <span class="hamburger-bar bar-2"></span>
            <span class="hamburger-bar bar-3"></span>
        </div>
    </label>
    <input type="checkbox" id="ch-menu">
<ul class="meniu">

    <li>
        <div class="text-icon" id="acasa">Acasa</div>
        <div class="image-icon" id="acasa-mediu">
        <span class="fas fa-regular fa-house"></span>
        </div>
        <ul>
        <li><a href="/index#acasa">Bine ati venit</a></li>
        <li><a href="/index#oferte">Oferte de vacanță</a></li>
        <li><a href="/index#pachete">Pachete turistice</a></li>
        <li><a href="/index#destinatii">Destinații populare</a></li>
        <li><a href="/index#planificare">Planifică vacanța</a></li>
        </ul>
    </li>
    <li>
        <div class="text-icon">Cont</div>
        <div class="image-icon">
            <span class="fas fa-regular fa-user"></span>
        </div>
        <ul>
        <% if (typeof user !== 'undefined' && user) { %>
        <li><a href="/rezervarile-mele">Rezervările mele</a></li>
        <li><a href="/wishlist">Wishlist</a></li>
        <li><a href="/logout">Deconectare</a></li>
        <% } else { %>
        <li><a href="/login">Autentificare</a></li>
        <li><a href="/register">Înregistrare</a></li>
        <% } %>
        </ul>
    </li>
    <li><div class="text-icon">Despre noi</div>
        <div class="image-icon">
            <span class="fas fa-regular fa-info-circle"></span>
        </div>
        <ul>
        <li><a href="/despre">Despre</a></li>
        <li><a href="/chat">Chatbot AI</a></li>
        </ul>
    </li>
    <li><div class="text-icon">Servicii</div>
        <div class="image-icon">
            <span class="fas fa-regular fa-info"></span>
        </div>
        <ul>
        <li><a href="/cautare">Căutare avansată</a></li>
        <li><a href="/recomandari">Recomandări AI</a></li>
        <li><a href="/harta">Hartă interactivă</a></li>
        </ul>
    </li>
    <li><div class="text-icon">Destinatii</div>
        <div class="image-icon">
            <span class="fas fa-regular fa-map-marker-alt"></span>
        </div>
        <ul>
            <li><a href="/produse">Toate</a></li>
            <li><a href="/produse?tip=cultural">Cultural</a></li>
            <li><a href="/produse?tip=aventura">Aventura</a></li>
            <li><a href="/produse?tip=relaxare">Relaxare</a></li>
            <li><a href="/produse?tip=urban">Urban</a></li>
            <li><a href="/harta">Hartă</a></li>
        </ul>
    </li>
    <li><div class="text-icon">Evenimente</div>
        <div class="image-icon">
            <span class="fas fa-regular fa-calendar-alt"></span>
        </div>
        <ul>
        <li><a href="/produse">Oferte speciale</a></li>
        <li><a href="/chat">Întreabă asistentul</a></li>
        </ul>
    </li>
<li><a href="/chat"> Contact <i class="fa-regular fa-envelope"></i></a></li>

</ul>
</nav>
<header  class="c1" id="h1">
     <label> <span class="bi bi-sun-fill"></span></label>
  
        <label> <span class="fas fa-sun"></span></label>
        <div class="form-check form-switch form-check-inline">
         <input id="tema" class="btn btn-primary btn-toggle form-check-input form-switch" type="checkbox">
          <label><span class="fas fa-moon"></span></label> </div>

    <h1>Aventura Travel <i class="fa-solid fa-plane fa-beat" style="color: rgb(99, 230, 190);"></i> </h1>
    <p class="slogan">Descoperă lumea cu noi!</p>
    <% if (typeof ip !== 'undefined') { %><p>Ip: <%- ip %></p><% } %>
</header>
